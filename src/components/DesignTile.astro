---
// One piece in a grid: photo on stone, name, code and weight, and the WhatsApp logo with the message ready.
import WaIcon from "./WaIcon.astro";
import { v } from "../lib/version.js";
const { p, eager = false, hidden = false } = Astro.props;
---
<div class="tile" hidden={hidden} data-code={p.id} data-category={p.category} data-motif={p.tag?.motif ?? ""} data-finish={p.tag?.finish ?? ""} data-occasion={p.tag?.occasion ?? ""} data-band={p.band} data-new={p.isNew ? "new" : ""}>
  <a href={`/design/${p.id}/`} class="link">
    <figure class="sc">
      {p.isNew && <span class="new">New</span>}
      <img class:list={[p.cut && "cut"]} src={v(`/designs/w/${p.id}-480.webp`)} srcset={`${v(`/designs/w/${p.id}-480.webp`)} 480w, ${v(`/designs/w/${p.id}-800.webp`)} 800w`} sizes="(max-width: 820px) 100vw, 320px" alt={`${p.name}, ${p.id}`} width="480" height="480" loading={eager ? "eager" : "lazy"} decoding="async" />
      <figcaption>
        <span class="name">{p.name}</span>
        <span class="spec">{p.id}, {p.weight}</span>
      </figcaption>
    </figure>
  </a>
  {p.wa && <a class="wa" href={p.wa} target="_blank" rel="noopener" aria-label={`Ask about ${p.id} on WhatsApp`} title="Ask on WhatsApp"><WaIcon size={20} /></a>}
</div>
<style>
  .tile[hidden] { display: none; }
  /* White, so the colour of the gold work is what you see; the piece under the pointer gets a fine gold edge. */
  .tile { display: grid; justify-items: center; align-content: start; padding: 12px 12px 18px; background: #fff; border: 1px solid transparent; transition: border-color .3s, box-shadow .3s; }
  .tile:hover, .tile:focus-within { border-color: rgba(160,124,58,.4); box-shadow: 0 8px 24px rgba(60,44,20,.06); }
  .link { display: block; width: 100%; text-decoration: none; color: inherit; }
  .sc { position: relative; margin: 0; text-align: center; }
  .sc img { position: relative; }
  .new { position: absolute; top: 6px; left: 6px; z-index: 2; padding: 3px 9px; border-radius: 999px; background: var(--kohl); color: var(--ivory); font: 500 11px/1.4 var(--body); letter-spacing: .08em; text-transform: uppercase; }
  .tile:hover .sc img, .link:focus-visible .sc img { transform: translateY(-6px) scale(1.03); }
  .tile:hover .name, .link:focus-visible .name { color: var(--gold-deep); }
  .sc img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; transition: opacity .25s, transform .35s cubic-bezier(.2,.7,.2,1); }
  /* A photo with its own backdrop fades at the edges; a cutout has no backdrop, so it needs no fade. */
  .sc img:not(.cut) { -webkit-mask-image: radial-gradient(closest-side, #000 78%, transparent 100%); mask-image: radial-gradient(closest-side, #000 78%, transparent 100%); }
  .sc img.waiting { opacity: 0; transition: none; }
  figcaption { display: grid; justify-items: center; gap: 3px; padding: 14px 6px 2px; }
  .name { font: 400 19px/1.25 var(--display); }
  .spec { font-size: 14px; color: var(--ash); font-variant-numeric: lining-nums; }
  .wa { margin-top: 10px; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; color: var(--kohl); border: 1px solid var(--line); }
  .wa:hover, .wa:focus-visible { background: #25d366; border-color: #25d366; color: #fff; }
  /* Phones: a feed, one piece across the full width, caption left and WhatsApp right, like a post. */
  @media (max-width: 820px) {
    .tile { grid-template-columns: 1fr auto; padding: 8px 0 22px; margin: 0; border: 0; border-bottom: 1px solid var(--line); }
    .tile:hover, .tile:focus-within { box-shadow: none; }
    .link { grid-column: 1 / -1; }
    .sc img { width: 100%; }
    figcaption { justify-items: start; padding: 10px 80px 0 16px; text-align: left; }
    .name { font-size: 21px; }
    .wa { grid-column: 2; grid-row: 1; align-self: end; margin: 0 16px 2px 0; width: 48px; height: 48px; }
    .link { grid-row: 1; }
  }
</style>
