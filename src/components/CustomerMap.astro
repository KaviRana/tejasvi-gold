---
// Where our customers are: one gold pin in each town. Drawn at build time from src/data/map.json (npm run map), no scripts.
import map from "../data/map.json";
const home = map.states.find((s) => s.n === "Maharashtra");
const around = map.states.filter((s) => s.n !== "Maharashtra");
---
<section class="customers" aria-labelledby="customers-h">
  <div class="wrap grid2">
    <div class="words">
      <h2 id="customers-h">Our customers</h2>
      <p>Jewellery shops across Maharashtra and Gujarat.</p>
    </div>
    <svg viewBox={map.viewBox} role="img" aria-label="Map of Maharashtra and nearby states with a gold pin in each town where we have customers">
      <g class="land">{around.map((s) => <path d={s.d} />)}</g>
      <path class="home" d={home.d} />
      <g class="pins">{map.pins.map((p) => <g transform={`translate(${p.x} ${p.y})`}><circle class="halo" r="13" /><circle class="dot" r="5" /></g>)}</g>
    </svg>
  </div>
</section>
<style>
  .customers { background: var(--bone); padding-block: 56px 48px; }
  .grid2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(24px, 6vw, 80px); align-items: center; }
  h2 { font-size: clamp(34px, 5vw, 52px); }
  .words p { margin-top: 12px; color: var(--ash); font-size: 20px; max-width: 24ch; }
  svg { display: block; width: 100%; max-width: 560px; height: auto; margin-inline: auto; }
  .land path { fill: #ece7db; stroke: rgba(160, 124, 58, .28); stroke-width: 1; stroke-linejoin: round; }
  .home { fill: #f1e3bf; stroke: var(--gold); stroke-width: 1.4; stroke-linejoin: round; }
  .halo { fill: rgba(160, 124, 58, .18); }
  .dot { fill: var(--gold-deep); stroke: #fffaf0; stroke-width: 1.5; }
  /* Phone: heading and line first, the map under it, all on one screen. */
  @media (max-width: 820px) {
    .customers { padding-block: 40px 32px; }
    .grid2 { grid-template-columns: 1fr; gap: 12px; }
    .words p { max-width: none; font-size: 18px; }
    svg { max-width: 420px; }
  }
</style>
