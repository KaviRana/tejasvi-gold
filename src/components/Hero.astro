---
// First screen: Kavita's painting, with her "Tejasvi Gold" lettering drawn in code as warm ivory with a gold edge,
// a slow gold light passing through it and a few sparkles. On a laptop the lettering sits where she placed it;
// on a phone the painting is cropped to the hands and the lettering moves to the top.
import glyphs from "./wordmark-glyphs.txt?raw";
import sparkles from "../data/sparkles.json";
import tray from "../data/tray.json";
import fingers from "../data/fingers.json";
// Real rings from the catalogue, one per motif, take turns in her fingers where the painted jewel was.
const { featured = [] } = Astro.props;
---
<section class="hero" aria-label="Tejasvi Gold">
  <div class="stage">
    <div class="held" aria-label="New pieces">
      {featured.map((p, i) => (
        <a class:list={["piece", { on: i === 0 }]} href={`/design/${p.id}/`} aria-label={`${p.name}, ${p.id}`} style={`--ax:${p.band[0]};--ay:${p.band[1]};--hang:${p.hang}deg`}>
          <img src={`/hero/pieces/${p.id}.webp`} alt="" width="480" height="480" loading={i === 0 ? "eager" : "lazy"} />
        </a>
      ))}
    </div>
    <img class="fingers" src="/hero/fingers.webp" alt="" fetchpriority="high" decoding="sync" style={`left:${fingers.left}%;top:${fingers.top}%;width:${fingers.width}%;height:${fingers.height}%`} />
    <a class="trayhit" href={`/design/${tray.code}/`} aria-label={`Bangle on the tray, ${tray.code}`} style={`left:${tray.left}%;top:${tray.top}%;width:${tray.width}%;height:${tray.height}%`}></a>
    <canvas class="sparks" aria-hidden="true" data-sparks={JSON.stringify(sparkles)}></canvas>
    <img class="paint" src="/hero/painting-1920.webp" srcset="/hero/painting-1280.webp 1280w, /hero/painting-1920.webp 1920w" sizes="(max-width: 820px) 1280px, 100vw" alt="A painted bride's hand dropping gold jewellery into another's palm, above a brass tray of jewels and flowers" width="1920" height="1080" fetchpriority="high" />
  </div>
  <div class="mark">
    <svg class="word" viewBox="626 43 793 406" role="img" aria-label="Tejasvi Gold">
      <defs>
        <linearGradient id="tgFill" x1="0" y1="43" x2="0" y2="449" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fffbf2" /><stop offset=".55" stop-color="#fbf0d8" /><stop offset="1" stop-color="#eed8a4" />
        </linearGradient>
        <linearGradient id="tgEdge" x1="626" y1="43" x2="1419" y2="449" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#b98a2e" /><stop offset=".5" stop-color="#f3d892" /><stop offset="1" stop-color="#a87a28" />
        </linearGradient>
        <linearGradient id="tgSheen" x1="300" y1="0" x2="520" y2="120" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fff3c4" stop-opacity="0" /><stop offset=".5" stop-color="#ffe9a8" stop-opacity=".95" /><stop offset="1" stop-color="#fff3c4" stop-opacity="0" />
          <animateTransform class="sweep" attributeName="gradientTransform" type="translate" values="0 0; 1300 0; 1300 0" keyTimes="0; .45; 1" dur="7s" repeatCount="indefinite" />
        </linearGradient>
        <g id="tgGlyphs" set:html={glyphs} />
      </defs>
      <use href="#tgGlyphs" class="base" />
      <use href="#tgGlyphs" class="sheen" />
    </svg>
    <p class="line">Wholesale Gold</p>
    <p class="corner tl">22K gold, hallmarked</p>
    <p class="corner br">Mumbai</p>
  </div>
</section>
<script>
  // A tap anywhere on the first screen goes straight to the catalogue (the ring and the tray bangle still open their pages).
  const heroEl = document.querySelector<HTMLElement>(".hero")!;
  heroEl.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) return;
    document.getElementById("catalogue")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  });
</script>
<script>
  // Kavita's sparkles, replayed from her animation: each one has its place on the painting, when it starts,
  // peaks and ends (in frames of 40 ms, looping every 5 s) and its size. Drawn on one canvas that follows
  // the painting's crop, so they stay on the jewels on every screen. Same data, same sparkles, every time.
  const canvas = document.querySelector<HTMLCanvasElement>(".hero .sparks")!;
  const img = document.querySelector<HTMLImageElement>(".hero .paint")!;
  const data = JSON.parse(canvas.dataset.sparks!) as { frames: number; frameMs: number; width: number; sparks: number[][] };
  const ctx = canvas.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let box = { x: 0, y: 0, w: 0, h: 0 }, dpr = 1, raf = 0, on = true;

  function layout() {
    // Where the painting actually shows inside its frame (object-fit: cover with its object-position).
    const r = canvas.getBoundingClientRect(); dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);
    const scale = Math.max(r.width / 1920, r.height / 1080), w = 1920 * scale, h = 1080 * scale;
    const [px, py] = getComputedStyle(img).objectPosition.split(" ").map((v) => parseFloat(v) / 100);
    box = { x: (r.width - w) * px, y: (r.height - h) * py, w, h };
    placeHeld();
  }
  // On a phone the painting is cropped, so the held piece is placed with the same box as the sparkles.
  const held = document.querySelector<HTMLElement>(".hero .held");
  function placeHeld() {
    if (!held) return;
    held.removeAttribute("style");
  }
  const pieces = [...document.querySelectorAll<HTMLElement>(".hero .piece")];
  let cur = 0;
  if (pieces.length > 1 && !still) setInterval(() => {
    pieces[cur].classList.remove("on"); cur = (cur + 1) % pieces.length; pieces[cur].classList.add("on");
  }, 2000);
  function star(x: number, y: number, s: number, a: number) {
    const g = ctx.createRadialGradient(x, y, 0, x, y, s * 0.9);
    g.addColorStop(0, `rgba(255,250,232,${a})`); g.addColorStop(0.35, `rgba(255,226,160,${a * 0.45})`); g.addColorStop(1, "rgba(255,210,130,0)");
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, s * 0.9, 0, 6.2832); ctx.fill();
    ctx.fillStyle = `rgba(255,252,240,${a})`;
    for (const [dx, dy, len, wid] of [[1, 0, 1.5, 0.09], [0, 1, 1.5, 0.09], [0.7071, 0.7071, 0.7, 0.06], [0.7071, -0.7071, 0.7, 0.06]]) {
      const L = s * len, W = s * wid, nx = -dy, ny = dx;
      ctx.beginPath();
      ctx.moveTo(x - dx * L, y - dy * L); ctx.lineTo(x + nx * W, y + ny * W);
      ctx.lineTo(x + dx * L, y + dy * L); ctx.lineTo(x - nx * W, y - ny * W); ctx.closePath(); ctx.fill();
    }
  }
  function draw(t: number) {
    const f = (t / data.frameMs) % data.frames;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.globalCompositeOperation = "lighter";
    const k = box.w / data.width;
    for (const [x, y, a0, pk, a1, size] of data.sparks) {
      if (f < a0 || f > a1 + 1) continue;
      // Rise to the peak, then fade: the same shape her sparkles follow.
      const e = f <= pk ? (f - a0 + 1) / (pk - a0 + 1) : 1 - (f - pk) / (a1 - pk + 2);
      const s = Math.max(2, size * k * 0.75) * (0.5 + 0.5 * e);
      star(box.x + (x / 100) * box.w, box.y + (y / 100) * box.h, s, Math.min(1, e * 1.1));
    }
    if (on) raf = requestAnimationFrame(draw);
  }
  if (still) { img.complete ? layout() : img.addEventListener("load", layout); addEventListener("resize", layout); }
  if (!still) {
    const go = () => { layout(); cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); };
    img.complete ? go() : img.addEventListener("load", go);
    addEventListener("resize", layout);
    new IntersectionObserver(([e]) => { on = e.isIntersecting; if (on) { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); } }).observe(canvas);
  }
</script>
<style>
  .hero { cursor: pointer; position: relative; height: 100svh; min-height: 540px; overflow: hidden; background: #1b140c; container-type: size; }
  /* The painting keeps its 16:9 shape and always covers the screen, so anything placed on it stays put. */
  .stage { position: absolute; top: 50%; left: 50%; width: max(100cqw, 177.78cqh); aspect-ratio: 16 / 9; transform: translate(-50%, -50%); }
  .stage { filter: brightness(1.05) saturate(1.05); }
  .paint { display: block; width: 100%; height: 100%; object-fit: cover; animation: settle 2.4s cubic-bezier(.2,.7,.2,1) both; }
  /* Laptop: the lettering top right, where Kavita placed it, sized to the visible screen so it is never cut off. */
  .mark { position: absolute; inset: 0; z-index: 3; pointer-events: none; --w: min(55cqw, 94cqh); --top: max(5.3cqh, 58px); }
  .word { position: absolute; right: 2.5cqw; top: var(--top); width: var(--w); height: auto; overflow: visible; filter: drop-shadow(0 3px 14px rgba(24,14,4,.55)) drop-shadow(0 1px 2px rgba(24,14,4,.5)); animation: rise 1.6s .3s cubic-bezier(.2,.7,.2,1) both; }
  .base { fill: url(#tgFill); stroke: url(#tgEdge); stroke-width: 1.4; paint-order: stroke; }
  .sheen { fill: url(#tgSheen); mix-blend-mode: screen; }
  /* The ring sits between the painting and her fingers: its thinnest band is pinched between her fingertips
     (45.2% across, 37% down) and it hangs straight down from there, turned by the angle tools/hero_cutouts.py
     measured for that ring. Nothing moves except the change from one ring to the next. */
  .stage { container-type: inline-size; }
  .held { position: absolute; z-index: 2; left: 45.2%; top: 37%; width: 0; height: 0; }
  .piece { position: absolute; width: 10cqw; aspect-ratio: 1; left: calc(var(--ax) * -10cqw); top: calc(var(--ay) * -10cqw); opacity: 0; transition: opacity .45s ease; transform-origin: calc(var(--ax) * 100%) calc(var(--ay) * 100%); rotate: var(--hang); pointer-events: none; }
  .piece.on { opacity: 1; pointer-events: auto; }
  .piece img { width: 100%; height: 100%; filter: drop-shadow(0 8px 10px rgba(30,18,6,.4)) saturate(1.05); }
  .fingers { position: absolute; z-index: 3; pointer-events: none; animation: settle 2.4s cubic-bezier(.2,.7,.2,1) both; }
  .trayhit { position: absolute; z-index: 2; border-radius: 50%; }
  .trayhit:focus-visible { outline: 2px solid #f3d892; }
  .sparks { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; pointer-events: none; }
  .line, .go { position: absolute; right: 2.5cqw; pointer-events: auto; color: #fbf3e2; text-shadow: 0 1px 10px rgba(24,14,4,.75); animation: rise 1.4s .9s both; }
  .line { top: calc(var(--top) + var(--w) * .512 + 10px); margin: 0; text-align: right; font: 400 clamp(22px, 2.2cqw, 34px)/1.2 var(--body); letter-spacing: .08em; }
  .corner { position: absolute; margin: 0; color: #fbf3e2; font: 400 clamp(15px, 1.2cqw, 19px)/1 var(--body); letter-spacing: .1em; text-shadow: 0 1px 10px rgba(24,14,4,.75); pointer-events: none; animation: rise 1.4s .9s both; }
  .tl { left: 2.5cqw; top: calc(env(safe-area-inset-top) + 24px); }
  .br { right: 2.5cqw; bottom: calc(env(safe-area-inset-bottom) + 28px); }
  .go { top: calc(var(--top) + var(--w) * .512 + 58px); font: 500 15px var(--body); letter-spacing: .04em; text-decoration: none; padding: 10px 0; border-bottom: 1px solid #e6c97c; }
  .go:hover { color: #f3d892; }

  /* Phone: the painting fills the screen, brighter and warmer; the name sits small at top right over the sky,
     clear of the hands; the line for retailers sits on a light card at the bottom, above the WhatsApp button. */
  @media (max-width: 820px) {
    .stage { transform: translate(-46.5%, -50%); }
    .stage { filter: brightness(1.14) saturate(1.08); }
    .mark { --w: 58vw; --top: calc(env(safe-area-inset-top) + 50px); }
    .word { right: 16px; }
    .line { right: 16px; left: auto; width: auto; top: calc(var(--top) + var(--w) * .512 + 6px); text-align: right; font-size: 20px; }
    .tl { left: 16px; top: calc(env(safe-area-inset-top) + 22px); font-size: 14px; }
    .br { right: 16px; bottom: calc(env(safe-area-inset-bottom) + 34px); font-size: 15px; }
  }
  @keyframes settle { from { transform: scale(1.06); opacity: .3; } to { transform: none; opacity: 1; } }
  @keyframes rise { from { opacity: 0; translate: 0 14px; } to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .sheen, .sparks { display: none; } }
</style>
