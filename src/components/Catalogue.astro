---
// The catalogue: search and chosen filters on top, filters in a column on the left, the grid on the right.
// On phones: one piece per row, swiped like a feed; filters open as a sheet. Used on / and /catalogue/.
import DesignTile from "./DesignTile.astro";
import attributes from "../data/attributes.json";
import business from "../data/business.json";
import { safeWa, UPDATES_MESSAGE } from "../lib/whatsapp.js";
const updates = safeWa(business.whatsapp, UPDATES_MESSAGE);

const { pieces: all, cats, heading = "h2" } = Astro.props;
// Default order mixes the kinds of piece: one from each category in turn (category order, then code),
// so the first page shows rings, bangles and necklaces together. Filters and search keep this order.
const byCat = cats.map((c) => all.filter((p) => p.category === c.id)).filter((l) => l.length);
const pieces = [];
for (let i = 0; byCat.some((l) => i < l.length); i++) for (const l of byCat) if (i < l.length) pieces.push(l[i]);
const H = heading;
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
// A value is listed only when some piece has it, in the fixed order of the lists.
const fromList = (values, key) => values.filter((v) => pieces.some((p) => key(p) === v)).map((v) => ({ value: slug(v), text: v, raw: v }));
const anyNew = pieces.some((p) => p.isNew);
const groups = [
  ...(anyNew ? [{ key: "new", label: "Added", attr: "new", options: [{ value: "new", text: "New", raw: "new" }] }] : []),
  { key: "cat", label: "Piece", attr: "category", options: cats.filter((c) => pieces.some((p) => p.category === c.id)).map((c) => ({ value: c.id, text: c.name, raw: c.id })) },
  { key: "occasion", label: "Occasion", attr: "occasion", options: fromList(attributes.occasion, (p) => p.tag?.occasion) },
  { key: "motif", label: "Motif", attr: "motif", options: fromList(attributes.motif, (p) => p.tag?.motif) },
  { key: "weight", label: "Weight", attr: "band", options: fromList(attributes.weight_band, (p) => p.band) },
  { key: "finish", label: "Finish", attr: "finish", options: fromList(attributes.finish, (p) => p.tag?.finish) },
].filter((g) => g.options.length > 1 || g.key === "new");
const tick = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8.2l2.6 2.6L12 5.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="catalogue" id="catalogue"><div class="wrap inner">
  <H class="sr-only">Catalogue</H>
  <div class="layout">
    <aside id="filters" class="side" aria-label="Filters">
      <div class="sheethead"><p>Filter</p><button type="button" class="close" aria-label="Close filters">×</button></div>
      <div class="groups">
        {groups.map((g) => (
          <div class="group" role="group" aria-label={g.label}>
            <p class="glabel">{g.label}</p>
            <ul>
              {g.options.map((o) => (
                <li><button class="opt" type="button" data-g={g.key} data-attr={g.attr} data-v={o.value} data-raw={o.raw} data-text={o.text} aria-pressed="false"><span class="tk" set:html={tick} />{o.text}</button></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="sheetfoot"><button type="button" class="clear" data-clear>Clear all</button><button type="button" class="done">Show pieces</button></div>
    </aside>
    <div class="main">
    {updates && <p class="updates">New designs every week. <a href={updates} target="_blank" rel="noopener">Get them on WhatsApp</a></p>}
    <div class="tools">
      <label class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21" /></svg>
        <span class="sr-only">Search by code, name or piece</span>
        <input id="q" type="search" inputmode="search" autocomplete="off" placeholder="Search by code" />
      </label>
      <button type="button" class="toggle" aria-expanded="false" aria-controls="filters">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4" /></svg>Filter<span id="activeN"></span>
      </button>
    </div>
    <div class="chosen" id="chosen" hidden></div>
      <p class="sr-only" aria-live="polite"><span id="count">{pieces.length}</span> designs shown</p>
      <div class="grid" id="grid">{pieces.map((p, i) => <DesignTile p={p} eager={i < 6} hidden={i >= 24} />)}</div>
      <nav class="pager" id="pager" aria-label="Pages"></nav>
      <p id="empty" class="empty" hidden>Nothing matches. Check the code, or <button type="button" class="clear inline" data-clear>clear the search and filters</button>.</p>
    </div>
  </div>
</div></section>
<script>
  // A piece shows only if it matches the search and every chosen filter group. The choice lives in the URL,
  // so a filtered or searched link opens the same view.
  const opts = [...document.querySelectorAll<HTMLButtonElement>(".opt[data-g]")];
  const tiles = [...document.querySelectorAll<HTMLElement>("#grid .tile")];
  const q = document.getElementById("q") as HTMLInputElement;
  const side = document.getElementById("filters")!;
  const toggle = document.querySelector(".toggle")!;
  const chosen = document.getElementById("chosen")!;
  const state: Record<string, string> = {};
  // Search text for each tile, built once: code, its number alone, name, piece type and weight.
  const hay = tiles.map((t) => (t.dataset.code + " " + t.dataset.code!.slice(3) + " " + (t.textContent || "")).toLowerCase().replace(/\s+/g, " "));

  function matchesQuery(i: number, query: string) {
    if (!query) return true;
    const code = query.toUpperCase().replace(/\s+/g, "").match(/^(?:TG-?)?(\d{3,5})$/);
    if (code) return tiles[i].dataset.code === `TG-${code[1]}`;
    return query.toLowerCase().split(/\s+/).every((w) => hay[i].includes(w));
  }

  // Pages, so the catalogue never becomes an endless scroll: 24 pieces on a laptop, 12 on a phone.
  const perPage = () => (matchMedia("(max-width: 820px)").matches ? 12 : 24);
  let page = 1;
  const pager = document.getElementById("pager")!;
  function pageList(total: number, cur: number) {
    // First, last, and the pages next to the current one; gaps shown as an ellipsis.
    const keep = new Set([1, total, cur - 1, cur, cur + 1].filter((x) => x >= 1 && x <= total));
    const out: (number | null)[] = []; let prev = 0;
    for (const x of [...keep].sort((a, b) => a - b)) { if (x - prev > 1) out.push(null); out.push(x); prev = x; }
    return out;
  }
  function drawPager(total: number) {
    pager.innerHTML = "";
    if (total <= 1) return;
    const mk = (label: string, to: number, opts: { cur?: boolean; dis?: boolean; aria?: string } = {}) => {
      const b = document.createElement("button"); b.type = "button"; b.textContent = label;
      if (opts.aria) b.setAttribute("aria-label", opts.aria);
      if (opts.cur) b.setAttribute("aria-current", "page");
      b.disabled = !!opts.dis;
      b.addEventListener("click", () => { page = to; render(); document.getElementById("catalogue")!.scrollIntoView(); });
      pager.appendChild(b);
    };
    mk("‹", page - 1, { dis: page === 1, aria: "Previous page" });
    for (const x of pageList(total, page)) {
      if (x === null) { const s = document.createElement("span"); s.textContent = "…"; pager.appendChild(s); }
      else mk(String(x), x, { cur: x === page, aria: `Page ${x}` });
    }
    mk("›", page + 1, { dis: page === total, aria: "Next page" });
  }

  // Pictures on the page being viewed start loading together, so a quick scroll on a weak signal never meets a blank card.
  let ready = document.readyState === "complete";
  const promote = () => tiles.forEach((t) => { if (!t.hidden) t.querySelector("img")?.setAttribute("loading", "eager"); });
  if (!ready) addEventListener("load", () => { ready = true; promote(); }, { once: true });

  function render() {
    const query = q.value.trim();
    opts.forEach((o) => o.setAttribute("aria-pressed", String(state[o.dataset.g!] === o.dataset.v)));
    const active = opts.filter((o) => state[o.dataset.g!] === o.dataset.v);
    let n = 0;
    const isCode = /^(?:TG-?)?\d{3,5}$/.test(query.toUpperCase().replace(/\s+/g, ""));
    const hits: HTMLElement[] = [];
    tiles.forEach((t, i) => {
      // A code finds its piece whatever filters are on; words narrow within the filters.
      const ok = isCode ? matchesQuery(i, query) : matchesQuery(i, query) && active.every((o) => t.dataset[o.dataset.attr!] === o.dataset.raw);
      if (ok) hits.push(t);
    });
    n = hits.length;
    const per = perPage(), total = Math.max(1, Math.ceil(n / per));
    page = Math.min(Math.max(1, page), total);
    const shown = new Set(hits.slice((page - 1) * per, page * per));
    tiles.forEach((t) => (t.hidden = !shown.has(t)));
    if (ready) promote();
    drawPager(total);
    document.getElementById("count")!.textContent = String(n);
    document.getElementById("empty")!.hidden = n > 0;
    document.getElementById("activeN")!.textContent = active.length ? ` (${active.length})` : "";
    chosen.hidden = active.length === 0;
    chosen.innerHTML = "";
    for (const o of active) {
      const b = document.createElement("button");
      b.type = "button"; b.className = "chip-on"; b.textContent = o.dataset.text!;
      b.setAttribute("aria-label", `Remove ${o.dataset.text}`);
      b.addEventListener("click", () => { state[o.dataset.g!] = ""; render(); });
      chosen.appendChild(b);
    }
    if (active.length > 1) {
      const c = document.createElement("button"); c.type = "button"; c.className = "clear"; c.textContent = "Clear all";
      c.addEventListener("click", clearAll); chosen.appendChild(c);
    }
    const params = new URLSearchParams(Object.entries(state).filter(([, v]) => v));
    if (query) params.set("q", query);
    if (page > 1) params.set("page", String(page));
    const s = params.toString();
    history.replaceState(null, "", (s ? `?${s}` : location.pathname) + location.hash);
  }
  function clearAll() { for (const k in state) state[k] = ""; q.value = ""; page = 1; render(); }
  function sheet(open: boolean) {
    toggle.setAttribute("aria-expanded", String(open));
    side.classList.toggle("open", open);
    document.documentElement.classList.toggle("sheet-open", open);
  }

  opts.forEach((o) => o.addEventListener("click", () => {
    state[o.dataset.g!] = state[o.dataset.g!] === o.dataset.v ? "" : o.dataset.v!;
    page = 1; render();
  }));
  q.addEventListener("input", () => { page = 1; render(); });
  document.querySelectorAll("[data-clear]").forEach((b) => b.addEventListener("click", clearAll));
  toggle.addEventListener("click", () => sheet(toggle.getAttribute("aria-expanded") !== "true"));
  side.querySelector(".close")!.addEventListener("click", () => sheet(false));
  side.querySelector(".done")!.addEventListener("click", () => { sheet(false); document.getElementById("catalogue")!.scrollIntoView(); });
  addEventListener("keydown", (e) => { if (e.key === "Escape") sheet(false); });

  const params = new URLSearchParams(location.search);
  const legacy = location.hash.slice(1); // old links: /catalogue/#ladies-ring
  if (legacy && !params.has("cat") && opts.some((o) => o.dataset.v === legacy)) params.set("cat", legacy);
  for (const [k, v] of params) if (opts.some((o) => o.dataset.g === k && o.dataset.v === v)) state[k] = v;
  if (params.get("q")) q.value = params.get("q")!;
  page = Math.max(1, parseInt(params.get("page") || "1", 10) || 1);
  render();
</script>
<style>
  .catalogue { position: relative; padding-block: 40px 96px; background: #fff; color: var(--kohl); }
  .inner { position: relative; }
  .updates { margin: 0 0 14px; font-size: 16px; color: var(--ash); }
  .updates a { color: var(--kohl); border-bottom: 1px solid var(--gold); text-decoration: none; }
  .tools { display: flex; gap: 12px; align-items: center; margin-bottom: 22px; }
  .search { flex: 1; display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 16px; background: #f7f6f3; border: 1px solid var(--line); border-radius: 999px; }
  .search:focus-within { border-color: var(--gold); }
  .search svg { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--ash); stroke-width: 1.6; stroke-linecap: round; }
  .search input { flex: 1; min-width: 0; border: 0; background: none; font: 400 16px var(--body); color: var(--kohl); outline: none; }
  .search input::placeholder { color: #8d8780; }
  .toggle { display: none; }
  .chosen { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 18px; }
  .chosen[hidden] { display: none; }
  .chosen :global(.chip-on) { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 14px; border: 0; border-radius: 999px; background: var(--kohl); color: var(--ivory); font: 400 14px var(--body); cursor: pointer; }
  .chosen :global(.chip-on)::after { content: "×"; font-size: 17px; line-height: 1; opacity: .7; }
  .chosen :global(.clear), .clear { background: none; border: 0; border-bottom: 1px solid var(--gold); padding: 2px 0; font: 400 14px var(--body); color: var(--kohl); cursor: pointer; }
  .layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 0 64px; align-items: start; }
  .side { position: sticky; top: 24px; padding: 14px 0 84px; max-height: calc(100vh - 48px); overflow-y: auto; padding-right: 6px; scrollbar-width: thin; }
  .sheethead, .sheetfoot { display: none; }
  .groups { display: grid; gap: 30px; }
  .glabel { font: 500 13px var(--body); letter-spacing: .14em; text-transform: uppercase; color: var(--kohl); margin-bottom: 8px; }
  .side ul { list-style: none; margin: 0; padding: 0; }
  .opt { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 38px; padding: 0; border: 0; background: none; font: 400 16px var(--body); color: #4a4642; text-align: left; cursor: pointer; }
  .opt:hover { color: var(--kohl); }
  .tk { flex: none; width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(26,24,23,.3); display: grid; place-items: center; color: transparent; transition: background-color .15s, border-color .15s; }
  .tk :global(svg) { width: 14px; height: 14px; }
  .opt[aria-pressed="true"] { color: var(--kohl); font-weight: 500; }
  .opt[aria-pressed="true"] .tk { background: var(--gold-deep); border-color: var(--gold-deep); color: var(--ivory); }
  .main .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .empty { padding: 48px 0; color: var(--ash); }
  .pager { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 56px; flex-wrap: wrap; }
  .pager:empty { display: none; }
  .pager :global(button) { min-width: 44px; height: 44px; padding: 0 10px; border: 1px solid transparent; border-radius: 999px; background: none; font: 400 16px var(--body); color: var(--kohl); cursor: pointer; font-variant-numeric: lining-nums; }
  .pager :global(button:hover:not(:disabled)) { border-color: var(--line); }
  .pager :global(button[aria-current="page"]) { background: var(--kohl); color: var(--ivory); }
  .pager :global(button:disabled) { opacity: .3; cursor: default; }
  .pager :global(span) { color: var(--ash); padding: 0 4px; }
  @media (max-width: 1000px) and (min-width: 821px) { .layout { grid-template-columns: 170px minmax(0, 1fr); gap: 0 36px; } }

  /* Phones: search and Filter stay at the top; one piece per row, swiped like a feed. */
  @media (max-width: 820px) {
    .catalogue { padding-top: 0; padding-inline: 0; }
    .tools { position: sticky; top: 0; z-index: 15; background: rgba(255,255,255,.94); padding: 10px 16px; margin: 0; border-bottom: 1px solid var(--line); }
    .chosen { padding: 12px 16px 0; margin: 0; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .chosen :global(.chip-on), .chosen :global(.clear) { flex: none; }
    .toggle { display: inline-flex; flex: none; align-items: center; gap: 6px; min-height: 48px; padding: 0 16px; border: 1px solid var(--line); border-radius: 999px; background: #f4f1ea; font: 500 14px var(--body); color: var(--kohl); cursor: pointer; }
    .toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
    .layout { display: block; margin: 0; }
    .side { position: fixed; inset: 0; z-index: 60; max-height: none; padding: 0; background: var(--stone); display: none; flex-direction: column; }
    .side.open { display: flex; animation: up .25s ease-out; }
    .sheethead { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-bottom: 1px solid var(--line); }
    .sheethead p { font: 400 24px var(--display); }
    .close { width: 44px; height: 44px; border: 0; background: none; font-size: 30px; line-height: 1; color: var(--kohl); cursor: pointer; }
    .groups { flex: 1; overflow-y: auto; padding: 20px 16px; gap: 26px; }
    .opt { min-height: 46px; font-size: 17px; }
    .sheetfoot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); }
    .done { min-height: 50px; padding: 0 28px; border: 0; border-radius: 999px; background: var(--kohl); color: var(--ivory); font: 500 15px var(--body); cursor: pointer; }
    .main .grid { grid-template-columns: 1fr; row-gap: 0; }
    .empty { padding: 32px 16px; }
    .pager { margin: 0; padding: 36px 16px 48px; }
  }
  @keyframes up { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  :global(html.sheet-open) { overflow: hidden; }
</style>
