---
import Base from "../../layouts/Base.astro";
import { v } from "../../lib/version.js";
import { loadPieces } from "../../lib/pieces.js";
import DesignTile from "../../components/DesignTile.astro";
import WaIcon from "../../components/WaIcon.astro";
import { pieceLook } from "../../lib/piece.js";

export async function getStaticPaths() {
  const { pieces } = await loadPieces(import.meta.env.SITE);
  // More like this: same piece type; then same motif, same finish, closest weight; code breaks ties.
  const like = (p) => pieces.filter((q) => q.id !== p.id && q.category === p.category)
    .map((q) => [q, (q.tag?.motif === p.tag?.motif ? 0 : 2) + (q.tag?.finish === p.tag?.finish ? 0 : 1), Math.abs(q.weight_max_g - p.weight_max_g)])
    .sort((a, b) => a[1] - b[1] || a[2] - b[2] || a[0].id.localeCompare(b[0].id))
    .slice(0, 8).map(([q]) => q);
  // Pairs with: one piece from each other kind of jewellery, chosen by same motif, then same occasion,
  // then same finish; code breaks ties. Gives shops (and search engines) a matching set to look at.
  const kinds = [...new Set(pieces.map((q) => q.category))];
  const pairs = (p) => kinds.filter((k) => k !== p.category).map((k) => pieces.filter((q) => q.category === k)
      .map((q) => [q, (q.tag?.motif === p.tag?.motif ? 0 : 4) + (q.tag?.occasion === p.tag?.occasion ? 0 : 2) + (q.tag?.finish === p.tag?.finish ? 0 : 1)])
      .sort((a, b) => a[1] - b[1] || a[0].id.localeCompare(b[0].id))[0]?.[0]).filter(Boolean);
  return pieces.map((p) => ({ params: { code: p.id }, props: { p, more: like(p), pair: pairs(p) } }));
}
const { p, more, pair } = Astro.props;
const lower = (x) => x.toLowerCase();
const pairLine = pair.length
  ? `Pairs with ${pair.map((q) => `the ${q.name} (${q.id})`).join(pair.length > 2 ? ", " : " and ").replace(/, ([^,]*)$/, " and $1")} for a matching ${p.tag ? lower(p.tag.motif) + " " : ""}set.`
  : "";
const STATUS = { "in-stock": "Ready stock", "on-approval": "On approval", "made-to-order": "Made to order" };

// Thin gold line icons, 24 x 24, drawn with strokes only.
const ICON = {
  weight: '<circle cx="12" cy="6" r="2.2"/><path d="M7 9h10l2.5 11h-15z"/>',
  purity: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  motif: '<path d="M5 19C5 10 10 5 19 5c0 9-5 14-14 14z"/><path d="M5 19L14 10"/>',
  finish: '<path d="M12 3c.6 4.5 3.5 7.4 8 8-4.5.6-7.4 3.5-8 8-.6-4.5-3.5-7.4-8-8 4.5-.6 7.4-3.5 8-8z"/>',
  work: '<path d="M12 3l8 9-8 9-8-9z"/><path d="M12 8l4 4-4 4-4-4z"/>',
  stones: '<path d="M6 4h12l3 5-9 11L3 9z"/><path d="M3 9h18M9 4l3 16M15 4l-3 16"/>',
  occasion: '<rect x="4" y="5" width="16" height="15" rx="1"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  status: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/>',
};
// One list of details, each once, in the order a shop asks. They fill three columns, row by row.
const specs = [
  ["weight", "Weight", p.weight],
  ...(p.tag ? [["stones", "Stones", p.tag.stones], ["finish", "Finish", p.tag.finish]] : []),
  ["purity", "Purity", p.tag ? `${p.purity}, HUID hallmark` : p.purity],
  ...(p.tag ? [["motif", "Motif", p.tag.motif], ["work", "Work", p.tag.work], ["occasion", "Occasion", p.tag.occasion]] : []),
  ["status", "Availability", p.dispatch_days ? `${STATUS[p.status]}, dispatch in ${p.dispatch_days} days` : STATUS[p.status]],
];
const shareText = `${p.name}, ${p.id}, ${p.weight}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.name,
  sku: p.id,
  image: new URL(p.image, Astro.site).href,
  description: p.description,
  url: p.url,
  category: p.cat.name,
  material: `${p.purity} gold`,
  weight: { "@type": "QuantitativeValue", value: p.weight_max_g, unitCode: "GRM" },
  brand: { "@type": "Brand", name: "Tejasvi Gold" },
  ...(p.tag ? { pattern: p.tag.motif } : {}),
};
const ld = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---
<Base title={`${p.name} ${p.id}`} description={`${p.description} ${pairLine}`.trim()} waLink={p.wa} floating={false} ogImage={v(`/share/${p.id}.jpg`)} ogSize={[1080, 1080]} ogDescription={`${p.weight}, ${p.purity} gold. Wholesale.`}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <section class="wrap first">
    <figure class="photo">
      <img class:list={[p.cut && "cut"]} src={v(`/designs/w/${p.id}-1200.webp`)} srcset={`${v(`/designs/w/${p.id}-800.webp`)} 800w, ${v(`/designs/w/${p.id}-1200.webp`)} 1200w`} sizes="(max-width: 820px) 100vw, 55vw" alt={`${p.name}, ${p.id}`} width="1200" height="1200" fetchpriority="high" />
    </figure>
    <div class="head">
      <div class="titlerow">
        <div>
          <h1>{p.name}</h1>
          <p class="code">{p.id}</p>
        </div>
        <button type="button" class="share" data-title={`${p.name}, ${p.id}`} data-text={shareText} data-url={p.url} data-card={v(`/share/${p.id}.jpg`)} data-file={`${p.id}.jpg`} aria-label="Share this design">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M8 8l4-4 4 4M5 12v7h14v-7" /></svg><span>Share</span>
        </button>
      </div>
      <ul class="specs">
        {specs.map(([icon, label, value]) => (
          <li><span class="h"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON[icon]} /><span class="k">{label}</span></span><span class="v">{value}</span></li>
        ))}
      </ul>
      <p class="desc">{[pieceLook(p.tag), pairLine].filter(Boolean).join(" ")}</p>
      {p.wa && <a class="ask" href={p.wa} target="_blank" rel="noopener"><WaIcon size={22} /><span>Ask on WhatsApp</span></a>}
    </div>
  </section>
  {pair.length > 0 && (
    <section class="wrap pairs">
      <h2>Pairs well with</h2>
      <div class="grid">{pair.map((q) => <DesignTile p={q} />)}</div>
    </section>
  )}
  {more.length > 0 && (
    <section class="wrap more">
      <h2>More like this</h2>
      <div class="grid">{more.map((q) => <DesignTile p={q} />)}</div>
    </section>
  )}
</Base>
<script>
  // One tap shares the picture of the piece (name, code, weight, logo and number on it), like sharing lyrics.
  // Phones open their share sheet with the picture attached. Anywhere that cannot share a file, the picture is saved.
  const btn = document.querySelector<HTMLButtonElement>(".share");
  const label = btn?.querySelector("span");
  let card: File | null = null;
  const canShareFile = () => !!card && !!navigator.canShare?.({ files: [card] });
  // Fetched once the page is idle, so the tap itself is instant (a phone only allows sharing straight after a tap).
  addEventListener("load", async () => {
    if (!btn) return;
    try {
      const blob = await (await fetch(btn.dataset.card!)).blob();
      card = new File([blob], btn.dataset.file!, { type: "image/jpeg" });
    } catch { card = null; }
    if (label) label.textContent = canShareFile() ? "Share" : "Save image";
  }, { once: true });
  btn?.addEventListener("click", async () => {
    const { title, text, url, card: cardUrl, file } = btn.dataset;
    try {
      if (card && canShareFile()) await navigator.share({ files: [card], title, text: `${text}\n${url}` });
      else {
        const a = document.createElement("a");
        a.href = card ? URL.createObjectURL(card) : cardUrl!; a.download = file!;
        document.body.appendChild(a); a.click(); a.remove();
      }
    } catch { /* closed the share sheet */ }
  });
  // The pieces further down the page load once the main photo is in, so scrolling on a weak signal never meets a blank card.
  addEventListener("load", () => document.querySelectorAll(".pairs img, .more img").forEach((i) => i.setAttribute("loading", "eager")), { once: true });
</script>
</Base>
<style>
  /* Laptop: photo left; name, code, the details in one clean table and the description right, all on one screen. */
  .first { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 88px); align-items: center; min-height: calc(100svh - 60px); padding-block: 12px 40px; }
  .photo { margin: 0; }
  .photo img { width: 100%; aspect-ratio: 1; object-fit: cover; -webkit-mask-image: radial-gradient(closest-side, #000 80%, transparent 100%); mask-image: radial-gradient(closest-side, #000 80%, transparent 100%); }
  .photo img.cut { -webkit-mask-image: none; mask-image: none; }
  .titlerow { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  h1 { font-size: clamp(30px, 4vw, 52px); line-height: 1.08; }
  .code { margin: 6px 0 0; font: 400 18px var(--display); color: var(--ash); letter-spacing: .04em; font-variant-numeric: lining-nums; }
  .share { flex: none; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 1px solid var(--line); border-radius: 999px; background: none; color: var(--kohl); font: 500 15px var(--body); cursor: pointer; }
  .share svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .share:hover, .share:focus-visible { border-color: var(--gold); color: var(--gold-deep); }
  /* The details: one grid, three columns, no lines. Every cell is a small icon and label on top and the value under it,
     so the icons, labels and values all start at the same left edge in each column and each row starts at the same height. */
  .specs { list-style: none; margin: 30px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 20px; }
  .specs li { display: grid; grid-template-rows: auto 1fr; row-gap: 6px; align-content: start; }
  .h { display: flex; align-items: center; gap: 8px; }
  .h svg { flex: none; width: 20px; height: 20px; fill: none; stroke: var(--gold); stroke-width: 1.15; stroke-linejoin: round; stroke-linecap: round; }
  .k { font-size: 13px; line-height: 20px; color: var(--ash); letter-spacing: .03em; }
  .v { font: 400 19px/1.3 var(--display); font-variant-numeric: lining-nums; }
  .desc { max-width: 52ch; margin: 24px 0 0; line-height: 1.65; color: var(--kohl-2); }
  .desc:empty { display: none; }
  /* The one action on this page, placed like an add-to-cart button: under the details on a laptop,
     fixed along the bottom of the screen on a phone. */
  .ask { display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; max-width: 420px; min-height: 56px; margin-top: 28px; background: var(--kohl); color: #fff; font: 500 19px var(--body); letter-spacing: .02em; text-decoration: none; transition: background-color .2s; }
  .ask:hover, .ask:focus-visible { background: var(--gold-deep); }
  .pairs { padding-block: 48px 8px; }
  .pairs h2, .more h2 { font-size: clamp(28px, 3vw, 38px); margin-bottom: 28px; }
  .more { padding-block: 56px 96px; }
  .more h2 { margin-bottom: 36px; }

  /* Phone: screen 1 is photo, name, code and the first details; the rest of the table, the description and more pieces follow. */
  @media (max-width: 820px) {
    .first { display: flex; flex-direction: column; gap: 8px; min-height: 0; padding: 0 16px 28px; }
    .photo img { -webkit-mask-image: none; mask-image: none; }
    h1 { font-size: 28px; }
    .specs { margin-top: 18px; gap: 22px 12px; }
    .v { font: 400 17px/1.3 var(--body); }
    .ask { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; max-width: none; margin: 0; min-height: 60px; padding-bottom: env(safe-area-inset-bottom); }
    .more { padding: 32px 0 80px; border-top: 1px solid var(--line); }
    .pairs { padding: 32px 0 0; border-top: 1px solid var(--line); }
    .pairs h2 { padding: 0 16px; margin-bottom: 8px; font-size: 30px; }
    .more h2 { padding: 0 16px; margin-bottom: 8px; font-size: 30px; }
  }
</style>
